# ---- Books & Audiobooks: ALL OPTIONAL ----------------------------------------------------------
# A missing key just switches that provider off (shown as "skipped" in the search response);
# nothing else is affected. Google Books, Open Library, Apple iTunes and Audnexus need no key.

# Hardcover (https://hardcover.app/account/api): series, narrators, runtime, ASIN, audiobook editions.
# This is the main source of audiobook narrator/runtime data - strongly recommended.
HARDCOVER_API_TOKEN=hc_pat_voDw6QaQGKTbbnbqzRXcox74J24LH8wWHzvjEWg4dkS3

# Google Books: works anonymously, but the shared anonymous quota is small. A free key avoids 429s.
GOOGLE_BOOKS_API_KEY=AIzaSyDzqCayyVjRIQbJCyvsrS21PJ6xl8iZ78k

# Open Library asks API clients to identify themselves: an e-mail or URL appended to the User-Agent.
OPENLIBRARY_CONTACT=

# Audible region used for ASIN lookups via Audnexus (au ca de es fr in it jp us uk) and the Apple storefront.
AUDNEXUS_REGION=us
ITUNES_COUNTRY=US

# Seconds to wait for each metadata provider (1-30, default 7) and an optional kill-switch list.
METADATA_PROVIDER_TIMEOUT=7
